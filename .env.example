# Product identity
WEBUI_NAME='ХЕРУВИМ'
DEFAULT_LOCALE='ru-RU'
# Сгенерируйте один раз: openssl rand -hex 32
WEBUI_SECRET_KEY=''

# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

# Основная LLM для ХЕРУВИМ. Должна быть OpenAI-compatible:
#   HERUVIM_LLM_BASE_URL + /chat/completions
#   HERUVIM_LLM_BASE_URL + /models не обязателен, модель регистрируется вручную.
# Примеры:
#   http://host.docker.internal:11434/v1
#   http://host.docker.internal:1234/v1
#   https://api.openai.com/v1
HERUVIM_LLM_BASE_URL=''
HERUVIM_LLM_MODEL=''
HERUVIM_LLM_API_KEY=''
HERUVIM_LLM_DISPLAY_NAME='ХЕРУВИМ'

# Обычные OpenAI/Ollama-подключения оставлены для совместимости upstream.
OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# ХЕРУВИМ -> локальный RAGFlow.
# Нормальный режим: RAGFlow — поиск/ingestion документов, LLM — через HERUVIM_LLM_*.
# Пользовательский чат не идет напрямую в RAGFlow: LLM вызывает RAGFlow
# как внутренний инструмент поиска, когда запрос требует документов.
# Для Docker Desktop используйте host.docker.internal; при нативном запуске — 127.0.0.1.
HERUVIM_RAGFLOW_BASE_URL='http://host.docker.internal:9380'
HERUVIM_RAGFLOW_API_KEY=''
HERUVIM_RAGFLOW_CHAT_ID=''
HERUVIM_RAGFLOW_DIRECT_CHAT_FALLBACK='false'
HERUVIM_RAGFLOW_SYNC_ATTACHMENTS='true'
HERUVIM_OPENWEBUI_INTERNAL_FILE_PROCESSING='false'
HERUVIM_OPENWEBUI_FILE_CONTEXT='false'
# Usually left empty: datasets are discovered from the chat assistant.
HERUVIM_RAGFLOW_DATASET_IDS=''
HERUVIM_RAGFLOW_SYNC_WORKERS='2'
HERUVIM_RAGFLOW_SYNC_POLL_SECONDS='3'
HERUVIM_RAGFLOW_SYNC_TIMEOUT_SECONDS='1200'
HERUVIM_REQUIRE_SOURCE_VERIFICATION='true'
HERUVIM_RAGFLOW_AUTO_RETRIEVAL='true'
HERUVIM_RAGFLOW_AUTO_RETRIEVAL_MODE='auto'
HERUVIM_RAGFLOW_RETRIEVAL_PAGE_SIZE='8'
HERUVIM_RAGFLOW_RETRIEVAL_SIMILARITY_THRESHOLD='0.2'
HERUVIM_RAGFLOW_RETRIEVAL_VECTOR_WEIGHT='0.3'
HERUVIM_RAGFLOW_FULL_DOCUMENTS='true'
HERUVIM_RAGFLOW_FULL_DOCUMENT_LIMIT='2'
HERUVIM_RAGFLOW_FULL_DOCUMENT_MAX_CHARS='60000'

# Direct backend calls to document editors. For native dev keep 127.0.0.1.
# docker-compose.mcp.yaml overrides these with Docker service names.
HERUVIM_DOCX_EDITOR_BASE_URL='http://127.0.0.1:9393'
HERUVIM_PDF_EDITOR_BASE_URL='http://127.0.0.1:9394'

# Shared Docker directory for chat uploads and generated documents only.
HERUVIM_DOCUMENTS_DIR='./.heruvim-documents'

# Упрощённый и безопасный интерфейс для основной аудитории.
DEFAULT_USER_ROLE='user'
# Для первичной регистрации владельца; после неё переключите на false.
ENABLE_SIGNUP='true'
USER_PERMISSIONS_CHAT_CONTROLS='false'
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT='false'
USER_PERMISSIONS_CHAT_PARAMS='false'
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS='false'
USER_PERMISSIONS_FEATURES_WEB_SEARCH='false'
USER_PERMISSIONS_FEATURES_IMAGE_GENERATION='false'
USER_PERMISSIONS_FEATURES_DIRECT_TOOL_SERVERS='false'

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
